# Copy to .env and fill in. Only OPENAI_API_KEY is required.
OPENAI_API_KEY=

# Models (defaults shown). TRANSCRIBE_MODEL can also be whisper-1 or
# gpt-4o-transcribe-diarize; gpt-6-luna also accepts CHAT_REASONING_EFFORT=none.
# TRANSCRIBE_MODEL=gpt-transcribe
# TRANSCRIBE_LANGUAGE=ko
# CHAT_MODEL=gpt-6.1-sol
# CHAT_REASONING_EFFORT=low

# Transcribe on this machine instead (pip install -r requirements-local-whisper.txt)
# USE_LOCAL_WHISPER=true
# WHISPER_MODEL=small

# Limits
# MAX_VIDEO_MINUTES=20
# MAX_UPLOAD_MB=300
# JOB_WORKERS=2
# MAX_PENDING_JOBS=8
# RATE_LIMIT_VIDEOS_PER_HOUR=10
# RATE_LIMIT_QUESTIONS_PER_HOUR=60
# RATE_LIMIT_FEEDBACK_PER_DAY=10
# RETENTION_HOURS=48

# "Ask the professor" mail through Resend. Set all three or the button stays
# hidden. FEEDBACK_FROM must use a domain you verified in Resend.
# PROFESSOR_EMAIL=
# RESEND_API_KEY=
# FEEDBACK_FROM="Lecture Q&A <lecture-qa@your-domain.com>"

# Only if YouTube starts asking the server to sign in
# YTDLP_COOKIES=/app/cookies.txt

# docker compose: public hostname for Caddy's HTTPS certificate
# DOMAIN=lecture.example.com
